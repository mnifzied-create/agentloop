# Copy this file to `.env.local` and fill in your key.
# Get an API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional — override the model. Defaults to claude-sonnet-4-6.
# Cheaper option for demos: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6
